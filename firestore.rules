rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // IMPORTANT:
    // Replace this email with the SAME email you put in config.js.
    // Requiring a verified email helps prevent someone from creating
    // an account using your address before you do.
    function isAdmin() {
      return signedIn()
        && request.auth.token.email == "CHANGE-ME@example.com"
        && request.auth.token.email_verified == true;
    }

    match /users/{userId} {
      // A player can read their own account.
      // The verified admin can read every player account.
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());

      // New account creation is limited to the authenticated user's own record,
      // and starting balance must be exactly 1,000 virtual coins.
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.coins == 1000;

      // Players may update their own game data.
      // The admin may update any player's data.
      //
      // NOTE: Game outcomes run in the browser, so a technically advanced player
      // can manipulate their OWN virtual coin balance. They still cannot change
      // other users' balances or obtain admin rights under these rules.
      allow update: if signedIn()
        && (request.auth.uid == userId || isAdmin());

      allow delete: if isAdmin();
    }
  }
}
